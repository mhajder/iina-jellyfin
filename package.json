{
  "name": "iina-jellyfin",
  "version": "0.7.2",
  "description": "Jellyfin plugin for IINA, enabling seamless media playback and subtitle management.",
  "homepage": "https://github.com/mhajder/iina-jellyfin",
  "bugs": {
    "url": "https://github.com/mhajder/iina-jellyfin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhajder/iina-jellyfin.git"
  },
  "license": "GPL-3.0-only",
  "author": "Mateusz Hajder",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "check": "eslint src/ && prettier --check . && vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "eslint": "^10.8.1",
    "iina-plugin-definition": "^0.99.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^3.2.7"
  }
}
